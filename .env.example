# MAC Security Platform - Environment Configuration
# Copy this file to .env and update with your settings

# ============================================
# Database Configuration
# ============================================
DB_USER=mac_admin
DB_PASSWORD=change_this_secure_password

# ============================================
# Redis Configuration
# ============================================
REDIS_PASSWORD=change_this_redis_password

# ============================================
# JWT Authentication
# ============================================
# Generate a strong secret key:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ============================================
# Sangfor API Integration (Optional)
# ============================================
SANGFOR_BASE_URL=https://your-sangfor-api.com/api/
SANGFOR_USERNAME=your_sangfor_username
SANGFOR_PASSWORD=your_sangfor_password

# ============================================
# Network Switch Configuration (Optional)
# ============================================
SWITCH_HOST=your-switch-ip-address
SWITCH_USERNAME=admin
SWITCH_PASSWORD=your_switch_password

# ============================================
# Backend CORS Configuration
# ============================================
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:80"]
