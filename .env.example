# ==============================================================================
# Terminal Access Platform - Complete Configuration File
# ==============================================================================
# Copy this file to .env and update with your settings.
# All configuration changes require restarting the backend service to take effect.
# ==============================================================================

# ==============================================================================
# [APPLICATION] Basic Application Settings
# ==============================================================================
# Application name displayed in browser title and sidebar
PROJECT_NAME=Terminal Access Platform
# Version string
VERSION=2.0.0
# API prefix path (no need to change)
API_V1_STR=/api/v1
# Environment: development | production | staging
# WARNING: production mode enforces strict security checks
ENVIRONMENT=development
# Enable debug mode (SQL echo, verbose logging)
# WARNING: Never enable in production!
DEBUG=false

# ==============================================================================
# [DATABASE] PostgreSQL Configuration
# ==============================================================================
# Full database connection URL
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://tam_admin:change_this_secure_password@postgres:5432/tam_db
# Individual database parameters (used if DATABASE_URL is not set)
DB_HOST=postgres
DB_PORT=5432
DB_USER=tam_admin
DB_PASSWORD=change_this_secure_password
DB_NAME=tam_db

# ==============================================================================
# [REDIS] Redis Configuration
# ==============================================================================
# Redis connection URL
REDIS_URL=redis://:change_this_redis_password@redis:6379/0
# Redis password (used if REDIS_URL is not set)
REDIS_PASSWORD=change_this_redis_password

# ==============================================================================
# [JWT] JSON Web Token Authentication
# ==============================================================================
# Secret key for JWT signing
# IMPORTANT: Generate a strong key with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# WARNING: Changing this will invalidate all existing tokens!
SECRET_KEY=change-this-to-a-random-secret-key-in-production
# Encryption key for field-level encryption (passwords, API keys in database)
# IMPORTANT: Must be DIFFERENT from SECRET_KEY in production!
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# WARNING: Changing this will make existing encrypted data unreadable!
ENCRYPTION_KEY=change-this-to-a-unique-encryption-key
# JWT algorithm (default: HS256)
ALGORITHM=HS256
# Access token expiration in minutes
# Range: 5-1440 (5 minutes to 24 hours)
# Default: 30
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token expiration in days
# Range: 1-90
# Default: 7
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# [SECURITY] Account Security Settings
# ==============================================================================
# Maximum failed login attempts before account lockout
# Range: 3-20
# Default: 5
MAX_LOGIN_ATTEMPTS=5
# Account lockout duration in minutes
# Range: 1-1440 (1 minute to 24 hours)
# Default: 15
LOCKOUT_DURATION_MINUTES=15
# Failed login attempts before captcha verification is required
# Range: 1-10 (must be <= MAX_LOGIN_ATTEMPTS)
# Default: 3
CAPTCHA_THRESHOLD=3
# Allow public user registration
# WARNING: Enable only if you want anyone to create an account
# Default: false
ALLOW_REGISTRATION=false

# ==============================================================================
# [RATE_LIMIT] API Rate Limiting
# ==============================================================================
# General API rate limit (requests per minute per IP)
# Range: 10-1000
# Default: 60
RATE_LIMIT_PER_MINUTE=60
# Authentication API rate limit (requests per minute per IP)
# Range: 1-30
# Default: 5
AUTH_RATE_LIMIT_PER_MINUTE=5

# ==============================================================================
# [SANGFOR] Sangfor AF Firewall Integration (Optional)
# ==============================================================================
# Enable by setting SANGFOR_BASE_URL. Leave empty to disable.
# Base URL for Sangfor AF API (e.g., https://10.0.0.1/api/)
SANGFOR_BASE_URL=
# Sangfor API credentials
SANGFOR_USERNAME=
SANGFOR_PASSWORD=
# CA bundle path for HTTPS verification (leave empty for default)
SANGFOR_CA_BUNDLE=

# ==============================================================================
# [SWITCH] Network Switch Integration (Optional)
# ==============================================================================
# Enable by setting SWITCH_HOST. Leave empty to disable.
# Switch management IP address
SWITCH_HOST=
# Switch SSH/Telnet credentials
SWITCH_USERNAME=
SWITCH_PASSWORD=
# Switch port (default: 23 for Telnet, 22 for SSH)
SWITCH_PORT=23

# ==============================================================================
# [IPGUARD] IPGuard Database Integration (Optional)
# ==============================================================================
# Enable by setting IPGUARD_HOST. Leave empty to disable.
# IPGuard database host
IPGUARD_HOST=
# IPGuard database credentials
IPGUARD_USER=
IPGUARD_PASSWORD=
# IPGuard database name (default: OCULAR3)
IPGUARD_DATABASE=OCULAR3

# ==============================================================================
# [CORS] Cross-Origin Resource Sharing
# ==============================================================================
# Comma-separated list of allowed origins
# Use ["*"] to allow all origins (NOT recommended for production)
# Default: ["http://localhost", "http://localhost:80"]
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:80"]

# ==============================================================================
# [LOGGING] Application Logging
# ==============================================================================
# Log level: DEBUG | INFO | WARNING | ERROR
# Default: INFO (WARNING recommended for production)
LOG_LEVEL=INFO

# ==============================================================================
# [BRANDING] UI Customization (also configurable via database settings API)
# ==============================================================================
# These values are seeded into the database on first startup and can be
# modified at runtime via the /api/v1/settings/ API endpoint.
# Changes via API take effect immediately without restart.
# .env values are only used as initial defaults when seeding.
#
# APP_NAME=Terminal Access Platform
# APP_SHORT_NAME=Terminal Access
# APP_SUBTITLE=Manager
# LOGIN_HEADING=Terminal Access Platform
# LOGIN_SUBHEADING=Sign in to your account
# LOGIN_FOOTER_TEXT=Secure authentication · Session-based access control
# FOOTER_COPYRIGHT=© {year} TerminalAccessManager (TAM)
# FOOTER_ICP_NUMBER=
# FOOTER_ICP_URL=https://beian.miit.gov.cn/
