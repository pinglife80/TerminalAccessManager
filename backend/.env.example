# Database Configuration
DATABASE_URL=postgresql+asyncpg://tam_admin:your_db_password@postgres:5432/tam_db
DB_HOST=postgres
DB_PORT=5432
DB_USER=tam_admin
DB_PASSWORD=your_db_password
DB_NAME=tam_db

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Sangfor API Configuration (optional)
SANGFOR_BASE_URL=
SANGFOR_USERNAME=
SANGFOR_PASSWORD=

# Switch Configuration (optional)
SWITCH_HOST=
SWITCH_USERNAME=
SWITCH_PASSWORD=
SWITCH_PORT=23

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your_redis_password

# Application Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_STR=/api/v1
PROJECT_NAME=TerminalAccessManager

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
